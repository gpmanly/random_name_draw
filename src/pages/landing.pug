include ../mixins/icons

.main
  .control-group
    button#fullscreen-button.icon-button.icon-button--small
      +svg-icon.red.big(svg-icon-name='fullscreen')
    button#settings-button.icon-button.icon-button--small
      +svg-icon.red.big(svg-icon-name='settings')

  canvas#confetti-canvas.confetti

  #prize-selection.prize-selection
    .prize-selection__panel
      h1.prize-selection__title Select Prize Type
      .prize-selection__actions
        button#minor-prizes-button.solid-button(type='button') Minor Prizes
        button#major-prizes-button.solid-button(type='button') Major Prizes

  #lucky-draw
    .title#minor-prizes-title
      //- Pug loader currently does not handle webpack alias so we will use relative path here
      include ../assets/images/title.svg

    .title#major-prizes-title
      img(src="~@images/title-major.svg" alt="Major Prizes")

    .slot
      .slot__outer
        .slot__inner
          .slot__shadow
          #reel.reel

      #sunburst.sunburst
        img(src="~@images/sunburst.svg" alt="sunburst")

    button#draw-button.solid-button Draw
    <audio id="clapSound" src="./assets/audio/applaudissement.mp3" loop></audio>

  #settings.settings
    #settings-panel.settings__panel
      div.settings__panel__group
        h1.settings__title Settings

        <input type="file" id="file-input" accept=".txt">
        button#settings-import.solid-button.solid-button Import
        br
        
        div.input-group
          label.input-label(for="name-list") Name List
          textarea.input-field.input-field--textarea(rows="8" placeholder="Separate each name by line break" id="name-list" readonly)

        div.input-group.input-group--2-column
          label.input-label(for="remove-from-list") Remove winner from list
          label.input--switch
            input(type="checkbox" checked="true" id="remove-from-list")
            span.slider

        div.input-group.input-group--2-column
          label.input-label(for="enable-sound") Enable sound effect
          label.input--switch
            input(type="checkbox" checked="true" id="enable-sound")
            span.slider

      div.settings__panel__group
        button#settings-save.solid-button.solid-button Save
        button#settings-close.solid-button.solid-button--danger Discard and close

      div.settings__panel__group
        div.input-group
          br
          br
          br
          label.input-label(for="winners-list") Winners List
          table#winners-list.winners-table
            thead
              tr
                th(scope="col") Winner
                th(scope="col") Time (PH)
            tbody#winners-list-body
          button#winners-download.solid-button(type="button" disabled) Download CSV


